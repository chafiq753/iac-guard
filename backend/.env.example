# Copier en .env et adapter.

# Base de données
# Dev sans Docker (SQLite, rien à installer) :
DATABASE_URL=sqlite:///./iacguard.db
# Dev avec Docker Compose — Postgres exposé sur localhost:5432 (voir docker-compose.yml).
# À utiliser si on lance SEULEMENT `docker compose up db` et l'API en local :
# DATABASE_URL=postgresql+psycopg://iacguard:iacguard@localhost:5432/iacguard
# NB : dans le conteneur `api`, l'URL utilise l'hôte `db` (réseau interne Compose)
# et est déjà fournie par docker-compose.yml — pas besoin de .env pour ce cas.

# Environnement : "development" ou "production".
# En production, l'application REFUSE de démarrer si SECRET_KEY est absente,
# trop courte, ou laissée à sa valeur par défaut — et si COOKIE_SECURE n'est
# pas activé. C'est volontaire : ce dépôt étant public, la clé par défaut
# l'est aussi, et un jeton signé avec elle est forgeable par n'importe qui.
ENVIRONMENT=development

# Clé de signature des JWT utilisateurs. 32 caractères minimum.
# En générer une avec :
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Impose HTTPS pour le cookie de session. False en dev (http://localhost),
# obligatoirement true en production.
COOKIE_SECURE=false

# Frontend autorisé (CORS). Liste explicite, jamais "*" : les cookies de
# session ne sont envoyés qu'avec allow_credentials=True, incompatible avec "*".
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
